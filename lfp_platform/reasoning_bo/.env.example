# DeepSeek LLM API (required for --use_llm --llm_backend deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# QwQ LLM API (required for --use_llm --llm_backend qwq)
QWQ_API_KEY=your_qwq_api_key_here
QWQ_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWQ_MODEL_NAME=qwq-32b-preview
